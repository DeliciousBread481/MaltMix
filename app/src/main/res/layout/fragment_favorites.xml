<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ========== 我的收藏夹 ========== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="我的收藏夹"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCreateFolder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="新建" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/localFoldersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- ========== 哔哩哔哩 ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="哔哩哔哩"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/biliStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#888888"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/biliFoldersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- ========== 网易云 ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="网易云"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/neteaseStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="网易云收藏夹：待接入"
            android:textColor="#888888"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/neteaseFoldersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>